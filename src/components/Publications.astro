---
import { load } from '../lib/data';
import type { Publications, Paper, Author } from '../lib/types';
import SectionHeader from './SectionHeader.astro';

const pubs = load<Publications>('publications.yaml');
const papers: Paper[] = pubs.papers || [];

/**
 * Venue kind for the placard stamp:
 *  - conference → CONFERENCE
 *  - journal    → JOURNAL
 *  - preprint   → PREPRINT (muted)
 */
function venueKind(paper: Paper): 'conference' | 'journal' | 'preprint' {
  const url = (paper.url || '').toLowerCase();
  if (url.includes('researchsquare') || url.includes('arxiv') || url.includes('osf.io')) {
    return 'preprint';
  }
  if (/journal|transactions|letters/i.test(paper.venue || '')) return 'journal';
  return 'conference';
}
---

<section id="publications" class="py-24 md:py-32 px-6 bg-surface-sunken scroll-mt-16">
  <div class="max-w-[960px] mx-auto">
    <SectionHeader label={pubs.label} heading={pubs.heading} />

    {
      papers.length > 0 && (
        <div class="space-y-4">
          {papers.map((paper: Paper, i: number) => {
            const kind = venueKind(paper);
            const serial = String(i + 1).padStart(2, '0');
            return (
              <article class="placard p-6 md:p-7">
                <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-3">
                  <span class="exhibit-num">N°{serial}</span>
                  {paper.venue && (
                    <span
                      class={`stamp ${kind === 'preprint' ? 'text-ink-tertiary border-border' : kind === 'journal' ? 'border-rust text-rust' : ''}`}
                    >
                      {kind}
                    </span>
                  )}
                  {paper.year && (
                    <span class="ml-auto text-[13px] font-mono text-ink-tertiary">
                      {paper.year}
                    </span>
                  )}
                </div>
                <a href={paper.url} target="_blank" rel="noopener" class="no-underline group">
                  <h3 class="font-display text-[18px] md:text-[20px] font-bold text-ink group-hover:text-accent transition-colors duration-200 m-0 mb-2 leading-[1.35]">
                    {paper.title}
                  </h3>
                </a>
                <p class="text-[15px] text-ink-secondary leading-[1.6] m-0 mb-3">
                  {paper.authors?.map((author: Author, j: number) => (
                    <span>
                      {j > 0 && ', '}
                      {author.bold ? (
                        <strong class="text-ink font-semibold">{author.name}</strong>
                      ) : (
                        <span>{author.name}</span>
                      )}
                    </span>
                  ))}
                </p>
                <div class="flex items-center gap-2.5">
                  {paper.venue && (
                    <span
                      class={`text-[13px] font-mono ${kind === 'preprint' ? 'text-ink-tertiary' : 'text-ink-secondary'}`}
                    >
                      {paper.venue}
                      {kind === 'preprint' && ' (preprint)'}
                    </span>
                  )}
                  {paper.url && (
                    <a
                      href={paper.url}
                      target="_blank"
                      rel="noopener"
                      class="text-[13px] font-mono text-accent hover:text-accent-light ml-auto shrink-0"
                    >
                      Publisher ↗
                    </a>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      )
    }
  </div>
</section>
