---
import { load, LORD_ICON_COLORS, liSrc } from '../lib/data';
import type { Skills, SkillCategory } from '../lib/types';
import SectionHeader from './SectionHeader.astro';

const skills = load<Skills>('skills.yaml');
const categories: SkillCategory[] = skills.categories || [];
---

<section id="skills" class="py-24 md:py-32 px-6 bg-surface scroll-mt-16">
  <div class="max-w-[960px] mx-auto">
    <SectionHeader label={skills.label} heading={skills.heading} headingMb="mb-12" />

    {
      categories.length > 0 && (
        <div>
          {categories.map((cat: SkillCategory) => (
            <div class="reveal flex flex-col md:flex-row md:items-baseline gap-2 md:gap-8 py-5 border-b border-border first:pt-0 last:border-0">
              <div class="flex items-center gap-2.5 md:w-52 shrink-0">
                {cat.icon && (
                  <lord-icon
                    src={liSrc(cat.icon)}
                    trigger="morph"
                    colors={LORD_ICON_COLORS.default}
                    class="li-lg"
                  />
                )}
                {cat.name && (
                  <h3 class="font-mono text-[13px] font-semibold text-accent m-0 uppercase tracking-[0.08em]">
                    {cat.name}
                  </h3>
                )}
              </div>
              {cat.items && cat.items.length > 0 && (
                <p class="font-mono text-[14px] leading-[1.9] text-ink-secondary m-0 min-w-0">
                  {cat.items.join('  ·  ')}
                </p>
              )}
            </div>
          ))}
        </div>
      )
    }
  </div>
</section>
