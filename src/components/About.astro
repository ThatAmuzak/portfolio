---
import { load } from '../lib/data';
import type { About, AboutParagraph, AboutSegment } from '../lib/types';
import SectionHeader from './SectionHeader.astro';

const about = load<About>('about.yaml');
const paragraphs = about.paragraphs || [];
// NOTE: about.stats are intentionally not rendered — the audit (bd
// portfolio-v2 redesign) retired the stat readout row; the same facts
// live in experience and publications. The YAML keeps them for reuse.
---

<section id="about" class="py-24 md:py-32 px-6 bg-surface-sunken scroll-mt-16">
  <div class="max-w-[820px] mx-auto">
    <SectionHeader label={about.label} heading={about.heading} />

    {
      paragraphs.length > 0 && (
        <div>
          {paragraphs.map((para: AboutParagraph, i: number) => (
            <p
              class={`text-[17px] md:text-[18px] text-ink-secondary leading-[1.75] ${i < paragraphs.length - 1 ? 'mb-5' : ''}`}
            >
              {para.segments.map((seg: AboutSegment, _j: number) =>
                seg.href ? (
                  <a
                    href={seg.href}
                    target="_blank"
                    rel="noopener"
                    class="text-accent hover:text-accent-light transition-colors underline-offset-2 hover:underline"
                  >
                    {seg.text}
                  </a>
                ) : seg.bold ? (
                  <strong class="text-ink font-semibold">{seg.text}</strong>
                ) : (
                  <>{seg.text}</>
                ),
              )}
            </p>
          ))}
        </div>
      )
    }
  </div>
</section>
