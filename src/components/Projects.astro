---
import { load, LORD_ICON_COLORS, liSrc } from '../lib/data';
import type { Projects, ProjectLink } from '../lib/types';
import SectionHeader from './SectionHeader.astro';

const projects = load<Projects>('projects.yaml');
const statuses = projects.statuses || [];
const items = projects.items || [];

// Build color map from statuses: { "Live": "#2D8A56", ... }
const statusColors: Record<string, string> = {};
statuses.forEach((s) => {
  if (s.color) statusColors[s.label] = s.color;
});
const defaultColor = '#6B7280';
---

<section id="projects" class="py-20 md:py-28 px-6 bg-surface-sunken scroll-mt-16">
  <div class="max-w-[1100px] mx-auto">
    <SectionHeader label={projects.label} heading={projects.heading} />

    {
      statuses.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-10" id="project-filter-tabs">
          {statuses.map((s) => {
            const label = s.label;
            return (
              <button
                class:list={[
                  'px-4 py-1.5 text-[13px] font-medium rounded-full border transition-colors cursor-pointer',
                  label === 'All'
                    ? 'bg-accent text-ink-on-dark border-accent'
                    : 'bg-transparent text-ink-secondary border-border hover:border-accent hover:text-accent',
                ]}
                data-filter={label}
              >
                {label}
              </button>
            );
          })}
        </div>
      )
    }

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="projects-grid">
      {
        items.map((project, i) => {
          const color = statusColors[project.status] || defaultColor;
          const allLinks = project.links || [];
          const primaryUrl = allLinks[0]?.url;
          const extraLinks: ProjectLink[] = allLinks.slice(1);
          return (
            <div
              class={`reveal ${i % 2 === 1 ? 'delay-1' : ''} card-glow bg-surface-raised rounded-[8px] p-7 flex flex-col ${primaryUrl ? 'cursor-pointer' : ''}`}
              data-status={project.status || ''}
              data-featured={project.featured ? 'true' : 'false'}
              data-href={primaryUrl || undefined}
            >
              <div class="flex items-start justify-between mb-4">
                <lord-icon
                  src={liSrc(project.icon || 'gsjfryhc')}
                  trigger="morph"
                  colors={LORD_ICON_COLORS.default}
                  class="li-2xl"
                />
                {project.status && (
                  <span
                    class="inline-block px-2 py-1 text-[11px] sm:text-[12px] sm:px-2.5 font-medium rounded font-mono uppercase whitespace-nowrap"
                    style={`color: ${color}; background: ${color}15;`}
                  >
                    {project.status}
                  </span>
                )}
              </div>
              {project.title && (
                <h3 class="font-display text-[21px] font-bold text-ink m-0 mb-1">
                  {project.title}
                </h3>
              )}
              {project.subtitle && (
                <p class="text-[15px] text-accent font-medium mb-3 mt-0">{project.subtitle}</p>
              )}
              {project.description && (
                <div class="mb-4">
                  <p class="project-desc text-[16px] text-ink-secondary leading-[1.7] mt-0 mb-0">
                    {project.description}
                  </p>
                  <button class="project-expand-toggle hidden text-[13px] font-medium text-accent hover:text-accent-light transition-colors cursor-pointer bg-transparent border-none p-0 mt-1">
                    Read more
                  </button>
                </div>
              )}
              <div class="mt-auto">
                {project.tech?.length > 0 && (
                  <div class="flex flex-wrap gap-1.5">
                    {project.tech.map((t: string) => (
                      <span class="inline-block px-2.5 py-1 text-[13px] font-medium rounded bg-accent-wash text-accent font-mono">
                        {t}
                      </span>
                    ))}
                  </div>
                )}
                {extraLinks.length > 0 && (
                  <div class="flex items-center gap-3 flex-wrap mt-4 pt-4 border-t border-border">
                    {extraLinks.map((link: ProjectLink) => (
                      <a
                        href={link.url}
                        target="_blank"
                        rel="noopener"
                        class="project-extra-link inline-flex items-center gap-1.5 text-[13px] font-medium text-ink-tertiary hover:text-accent transition-colors no-underline"
                        aria-label={link.label || ''}
                      >
                        <lord-icon
                          src={liSrc(link.icon)}
                          trigger="morph"
                          colors={LORD_ICON_COLORS.default}
                          class="li-sm"
                        />
                        {link.label}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </div>
          );
        })
      }
    </div>

    <div class="flex justify-center mt-8" id="projects-expand-wrap">
      <button
        id="projects-expand-btn"
        class="inline-flex items-center gap-2 px-5 py-2.5 text-[15px] font-medium text-ink-secondary hover:text-accent transition-colors cursor-pointer bg-transparent border border-border rounded-full hover:border-accent"
      >
        More projects
        <lord-icon
          src={liSrc('gupcdncx')}
          trigger="morph"
          colors={LORD_ICON_COLORS.default}
          class="li-md"
          id="expand-arrow"></lord-icon>
      </button>
    </div>
  </div>
</section>
