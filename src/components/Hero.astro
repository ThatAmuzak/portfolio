---
/**
 * Hero.astro — the exhibit entrance.
 *
 * Left: curatorial line, wall title, caption, CTA hierarchy
 * (primary rust = resume). Right: a glass case that cycles the
 * full toy collection — a random exhibit on load, auto-advance
 * every 15s, tap the case for the next exhibit (desktop + mobile).
 * "Interact with this exhibit" (desktop) opens the full CanvasToy
 * panel pre-loaded with the toy the case is currently showing.
 *
 * NOTE: the toy list here is duplicated in CanvasToy.astro's script
 * (SSR there, client here). Keep both in sync when adding toys.
 */
import { load } from '../lib/data';
import type { Hero } from '../lib/types';

const hero = load<Hero>('hero.yaml');
---

<section class="relative min-h-svh flex items-center px-5 md:px-6 pt-24 pb-10 md:pb-16 bg-surface">
  <div
    id="hero-content"
    class="max-w-[1100px] mx-auto w-full grid items-center gap-10 lg:gap-14 lg:grid-cols-[1.05fr_0.95fr]"
  >
    <!-- Left: wall text -->
    <div>
      {
        hero.subtitle && (
          <p class="text-[13px] md:text-[14px] font-mono text-rust tracking-[0.18em] uppercase mb-4 md:mb-5">
            {hero.subtitle}
          </p>
        )
      }
      {
        hero.name && (
          <h1 class="font-display text-[42px] sm:text-[52px] md:text-[64px] xl:text-[72px] font-bold text-ink leading-[1.05] tracking-[-0.01em] m-0 mb-5 md:mb-6 break-words">
            {hero.name}
          </h1>
        )
      }
      {
        hero.description && (
          <p class="text-[17px] md:text-[19px] text-ink-secondary leading-[1.7] mb-8 md:mb-10 max-w-[540px]">
            {hero.description}
          </p>
        )
      }
      <div id="hero-ctas" class="flex flex-wrap items-center gap-4">
        {
          hero.cta?.resume && (
            <a href={hero.cta.resume.href} class="btn-primary no-underline">
              <svg
                class="w-[20px] h-[20px] shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                <polyline points="7 10 12 15 17 10" />
                <line x1="12" y1="15" x2="12" y2="3" />
              </svg>
              {hero.cta.resume.label}
            </a>
          )
        }
        {
          hero.cta?.blogs && (
            <a href={hero.cta.blogs.href} class="btn-outline no-underline">
              {hero.cta.blogs.label}
            </a>
          )
        }
        {
          hero.cta?.connect && (
            <a
              href={hero.cta.connect.href}
              class="text-[16px] font-medium text-ink-secondary hover:text-accent transition-colors no-underline underline-offset-4 hover:underline"
            >
              {hero.cta.connect.label}
            </a>
          )
        }
      </div>
    </div>

    <!-- Right: the exhibit — glazed vitrine, placard label -->
    <div class="case w-full max-w-[480px] justify-self-center lg:justify-self-end">
      <!-- Vitrine: framed case with a placard-white mat and hairline inner edge -->
      <div class="case-vitrine">
        <div class="case-screen aspect-[4/3]">
          <canvas
            id="hero-toy-canvas"
            class="absolute inset-0 w-full h-full"
            aria-label="Live exhibit case — simulations run automatically"
            role="img"></canvas>
          {
            /* Glass pane: slightly translucent sheet over the case.
              Slides out halfway when the Interact button is hovered —
              a vitrine door left ajar, inviting the visitor in. */
          }
          <div id="case-glass" class="case-glass" aria-hidden="true"></div>
          {
            /* Tap layer: covers the canvas so the toys' own click handlers
              (pendulum reset, etc.) never fire — a tap always advances to
              the next exhibit, on desktop and mobile alike. */
          }
          <button
            id="case-tap"
            type="button"
            aria-label="Show the next exhibit"
            class="absolute inset-0 w-full h-full cursor-pointer bg-transparent border-0 p-0 select-none"
          ></button>
        </div>
      </div>

      <!-- Placard: detached label card standing in front of the vitrine -->
      <div class="case-placard">
        <div class="flex items-start gap-2 mb-2">
          <span id="case-number" class="exhibit-num select-none">№01</span>
          <h2
            id="case-title"
            class="m-0 font-display text-[19px] font-bold text-ink tracking-[-0.01em] leading-[1.2]"
          >
            Boids
          </h2>
          <span class="stamp stamp-rust ml-auto self-center select-none" aria-hidden="true"
            >Touch</span
          >
        </div>
        <p
          id="case-caption"
          class="text-[13px] text-ink-tertiary font-mono leading-relaxed m-0 mb-4 select-none"
        >
          Flocking birds. Three Rules, Emergent Order.
        </p>
        <div class="pt-3 border-t border-border flex flex-wrap items-center gap-3">
          <button
            id="canvas-toy-toggle"
            type="button"
            aria-label="Open the interactive exhibits panel"
            class="hidden md:inline-flex items-center gap-2 px-4 py-2.5 text-[14px] font-mono font-medium text-rust hover:text-ink transition-colors cursor-pointer bg-surface-sunken hover:bg-rust-wash border border-border hover:border-rust rounded-[2px]"
          >
            Interact with this exhibit
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Keep in sync with CanvasToy.astro's toy list when adding toys.
  import { boidsToy } from '../scripts/toys/boids.ts';
  import { clothToy } from '../scripts/toys/cloth.ts';
  import { doublePendulumToy } from '../scripts/toys/double-pendulum.ts';
  import { gameOfLifeToy } from '../scripts/toys/game-of-life.ts';
  import { newtonsCradleToy } from '../scripts/toys/newtons-cradle.ts';
  import { tetrisSolverToy } from '../scripts/toys/tetris.ts';
  import { threeBodyToy } from '../scripts/toys/three-body.ts';
  import type { CanvasToy } from '../lib/types';

  const TOYS: CanvasToy[] = [
    boidsToy,
    clothToy,
    doublePendulumToy,
    gameOfLifeToy,
    newtonsCradleToy,
    tetrisSolverToy,
    threeBodyToy,
  ];

  const AUTO_ADVANCE_MS = 15000;

  /** Proper display names for toys whose ids don't capitalize well. */
  const NAME_OVERRIDES: Record<string, string> = {
    'newtons-cradle': "Newton's Cradle",
    tetris: 'Tetris Solver',
    'game-of-life': 'Game of Life',
  };

  function startCaseCycler() {
    const canvas = document.getElementById('hero-toy-canvas') as HTMLCanvasElement | null;
    const numberEl = document.getElementById('case-number');
    const titleEl = document.getElementById('case-title');
    const captionEl = document.getElementById('case-caption');
    const toggleBtn = document.getElementById('canvas-toy-toggle');
    const tapLayer = document.getElementById('case-tap');
    if (!canvas || !titleEl || !captionEl) return;

    // Vitrine door: hovering/focusing the Interact button slides the glass
    // pane halfway out, inviting the visitor in. Mobile has no button, so
    // the glass stays closed there (the panel is still reachable). No-op
    // when the elements are missing or the button is display:none.
    const vitrine = document.querySelector('.case-vitrine');
    const glass = document.getElementById('case-glass');
    if (toggleBtn && vitrine && glass) {
      const doorOpen = () => vitrine.classList.add('glass-open');
      const doorClose = () => vitrine.classList.remove('glass-open');
      toggleBtn.addEventListener('mouseenter', doorOpen);
      toggleBtn.addEventListener('mouseleave', doorClose);
      toggleBtn.addEventListener('focus', doorOpen);
      toggleBtn.addEventListener('blur', doorClose);
    }

    let current = Math.floor(Math.random() * TOYS.length);
    let simCleanup: (() => void) | null = null;
    let timer: ReturnType<typeof setInterval> | null = null;
    let panelOpen = false;

    /** Placard title: overridden name or id words capitalized. */
    function titleFor(i: number): string {
      const toy = TOYS[i];
      if (NAME_OVERRIDES[toy.id]) return NAME_OVERRIDES[toy.id];
      return toy.id
        .split('-')
        .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
        .join(' ');
    }

    /** One-line preview caption; falls back to tag-stripped footer copy. */
    function captionFor(i: number): string {
      const toy = TOYS[i];
      if (toy.previewText) return toy.previewText;
      const div = document.createElement('div');
      div.innerHTML = toy.footerHtml;
      return div.textContent?.replace(/\s+/g, ' ').trim() ?? '';
    }

    function show(i: number) {
      if (simCleanup) {
        simCleanup();
        simCleanup = null;
      }
      current = i;
      if (numberEl) numberEl.textContent = `№${String(i + 1).padStart(2, '0')}`;
      titleEl!.textContent = titleFor(i);
      captionEl!.textContent = captionFor(i);
      if (toggleBtn) toggleBtn.dataset.toyId = TOYS[i].id;
      try {
        simCleanup = TOYS[i].start(canvas!);
      } catch (err) {
        console.error('[Hero] Exhibit failed to start:', err);
      }
    }

    function next() {
      show((current + 1) % TOYS.length);
    }

    function restartTimer() {
      if (timer) clearInterval(timer);
      timer = setInterval(() => {
        if (!panelOpen) next();
      }, AUTO_ADVANCE_MS);
    }

    let resumeRaf = 0;
    let resumeTimeout: ReturnType<typeof setTimeout> | null = null;

    /** Blank the exhibit: stop the sim and clear the canvas. The canvas
     *  is transparent over .case-screen's --color-case-bg, so a cleared
     *  canvas reads as an empty vitrine that respects the current theme. */
    function blankCase() {
      if (simCleanup) {
        simCleanup();
        simCleanup = null;
      }
      const ctx = canvas!.getContext('2d');
      if (ctx) ctx.clearRect(0, 0, canvas!.width, canvas!.height);
    }

    /** Re-initialize the exhibit once the case has expanded back into
     *  view. Toys measure the canvas in start() and only re-measure on
     *  window resize, so starting while the un-collapse transition
     *  (0.55s max-width/max-height) is still running would freeze them
     *  at a tiny/wrong size. The exhibit starts once the case rect has
     *  stopped changing for a few frames; a timeout safety net covers
     *  any case where no transition runs. */
    function resumeCase(idx: number) {
      cancelAnimationFrame(resumeRaf);
      if (resumeTimeout) clearTimeout(resumeTimeout);
      const caseEl = canvas!.closest('.case') as HTMLElement | null;
      if (!caseEl) {
        show(idx);
        restartTimer();
        return;
      }

      const settle = () => {
        resumeRaf = 0;
        if (resumeTimeout) {
          clearTimeout(resumeTimeout);
          resumeTimeout = null;
        }
        if (panelOpen) return; // reopened mid-resume; panel owns the toy
        show(idx);
        restartTimer();
      };

      resumeTimeout = setTimeout(settle, 900);
      let lastW = -1;
      let stableFrames = 0;
      const step = () => {
        const w = caseEl.getBoundingClientRect().width;
        stableFrames = w > 0 && Math.abs(w - lastW) < 0.5 ? stableFrames + 1 : 0;
        lastW = w;
        if (stableFrames >= 4) {
          settle();
          return;
        }
        resumeRaf = requestAnimationFrame(step);
      };
      resumeRaf = requestAnimationFrame(step);
    }

    // Panel continuity: the full panel opens with the toy the case is
    // currently showing (id carried on the toggle button). The panel
    // announces open/close so the case pauses instead of double-running.
    document.addEventListener('canvas-toy-panel', ((e: CustomEvent<{ isOpen: boolean }>) => {
      panelOpen = e.detail.isOpen;
      if (panelOpen) {
        // Free the case's sim while the panel runs the exhibit full-size,
        // and drop any pending resume so it can't fire behind the panel.
        cancelAnimationFrame(resumeRaf);
        if (resumeTimeout) {
          clearTimeout(resumeTimeout);
          resumeTimeout = null;
        }
        blankCase();
      } else {
        // Blank immediately so the fading-back case shows clean vitrine
        // glass (not a stale frozen frame) while it expands into view.
        blankCase();
        const exitedId = toggleBtn?.dataset.toyId;
        const exitedIdx = exitedId ? TOYS.findIndex((t) => t.id === exitedId) : -1;
        resumeCase(exitedIdx >= 0 ? exitedIdx : current);
      }
    }) as EventListener);

    tapLayer?.addEventListener('click', () => {
      if (panelOpen) return;
      next();
      restartTimer();
    });

    show(current);
    restartTimer();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startCaseCycler);
  } else {
    startCaseCycler();
  }

  // Smooth-scroll for the in-page CTA (same behavior as main.js nav links).
  document.querySelectorAll('#hero-ctas a[href^="#"]').forEach((link) => {
    link.addEventListener('click', function (this: HTMLAnchorElement, e) {
      e.preventDefault();
      const target = document.querySelector(this.getAttribute('href')!);
      if (target) scrollToTarget(target as HTMLElement);
    });
  });
</script>
