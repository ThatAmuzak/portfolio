---
import { load, LORD_ICON_COLORS, liSrc } from '../lib/data';
import type { Hero } from '../lib/types';

const hero = load<Hero>('hero.yaml');
---

<section class="relative min-h-svh flex items-center px-5 md:px-6 pt-20 pb-8 md:pb-16 bg-surface">
  <div class="hero-ambient" aria-hidden="true"></div>
  <div
    id="hero-content"
    class="max-w-[760px] mx-auto md:mx-0 md:ml-[max(calc((100%-960px)/2),1.5rem)]"
  >
    {
      hero.subtitle && (
        <div class="reveal">
          <p class="text-[13px] md:text-[15px] font-mono text-rust tracking-[0.12em] uppercase mb-4 md:mb-5">
            {hero.subtitle}
          </p>
        </div>
      )
    }
    {
      hero.name && (
        <div class="reveal delay-1 flex items-center gap-4 mb-5 md:mb-7">
          {hero.icon && (
            <lord-icon
              src={liSrc(hero.icon)}
              trigger="morph"
              colors={LORD_ICON_COLORS.default}
              class="li-hero hidden md:block"
            />
          )}
          <h1 class="font-display text-[38px] sm:text-[46px] md:text-[60px] lg:text-[72px] font-bold text-ink leading-[1.05] tracking-[-0.01em] m-0 break-words">
            {hero.name}
          </h1>
        </div>
      )
    }
    {
      hero.description && (
        <p class="reveal delay-2 text-[17px] md:text-[20px] text-ink-secondary leading-[1.7] mb-8 md:mb-10 max-w-[580px]">
          {hero.description}
        </p>
      )
    }
    <div id="hero-ctas" class="reveal delay-3 flex flex-wrap items-center gap-4">
      {
        hero.cta?.resume && (
          <a
            href={hero.cta.resume.href}
            class="inline-flex items-center gap-3 px-7 py-4 bg-accent text-on-accent text-[17px] sm:text-[18px] font-semibold rounded-[8px] no-underline hover:bg-accent-light active:scale-[0.98] transition-[background-color,transform] duration-200"
          >
            <svg
              class="w-[22px] h-[22px] shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
              <polyline points="7 10 12 15 17 10" />
              <line x1="12" y1="15" x2="12" y2="3" />
            </svg>
            {hero.cta.resume.label}
          </a>
        )
      }
      {
        hero.cta?.blogs && (
          <a
            href={hero.cta.blogs.href}
            class="inline-flex items-center gap-3 px-7 py-4 text-ink-secondary text-[17px] sm:text-[18px] font-semibold rounded-[8px] no-underline border border-border hover:border-accent hover:text-accent active:scale-[0.98] transition-[border-color,color,transform] duration-200"
          >
            {hero.cta.blogs.icon && (
              <lord-icon
                src={liSrc(hero.cta.blogs.icon)}
                trigger="morph"
                colors={LORD_ICON_COLORS.default}
                class="li-lg"
              />
            )}
            {hero.cta.blogs.label}
          </a>
        )
      }
      {
        hero.cta?.connect && (
          <a
            href={hero.cta.connect.href}
            class="inline-flex items-center gap-3 px-7 py-4 text-ink-secondary text-[17px] sm:text-[18px] font-semibold rounded-[8px] no-underline border border-border hover:border-accent hover:text-accent active:scale-[0.98] transition-[border-color,color,transform] duration-200"
          >
            {hero.cta.connect.icon && (
              <lord-icon
                src={liSrc(hero.cta.connect.icon)}
                trigger="morph"
                colors={LORD_ICON_COLORS.default}
                class="li-lg"
              />
            )}
            {hero.cta.connect.label}
          </a>
        )
      }
      {
        /* Toys / "Bored?" button — rendered statically here like the other CTAs.
          It just opens the CanvasToy panel; its click handler lives in
          CanvasToy.astro (looked up via #canvas-toy-toggle). */
      }
      <button
        id="canvas-toy-toggle"
        type="button"
        aria-label="Open interactive toy"
        class="select-none hidden md:inline-flex items-center gap-3 px-7 py-4 text-ink-secondary text-[17px] sm:text-[18px] font-semibold rounded-[8px] no-underline border border-border hover:border-rust hover:text-rust active:scale-[0.98] transition-[border-color,color,transform] duration-200 cursor-pointer"
      >
        <lord-icon
          src={liSrc('bazecvhf')}
          trigger="morph"
          colors={LORD_ICON_COLORS.default}
          class="li-lg"></lord-icon>
        Bored?
      </button>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('a[href^="#"]').forEach((link) => {
    link.addEventListener('click', function (this: HTMLAnchorElement, e) {
      e.preventDefault();
      const target = document.querySelector(this.getAttribute('href')!);
      if (target) scrollToTarget(target as HTMLElement);
    });
  });
</script>
