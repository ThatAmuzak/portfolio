---
/**
 * CanvasToy.astro — Generic panel for canvas-based interactive toys.
 *
 * Accepts an array of CanvasToy definitions (see src/lib/types.ts).
 * On open, picks a random toy. Once open, prev/next buttons (between
 * canvas and footer) let the user cycle through available toys.
 *
 * Hidden on mobile; the panel slides in from the right taking ~50vw.
 *
 * The "Bored?" toggle button (id="canvas-toy-toggle") lives statically in
 * Hero.astro's CTA row, like the other hero buttons, and just opens this panel.
 */
// NOTE: Toy imports are duplicated in the <script> block below.
// This is intentional — the frontmatter runs at build time for SSR
// (rendering the default header/footer), while the <script> runs on
// the client for rotation. Both are needed; keep them in sync.
import { boidsToy } from '../scripts/toys/boids.ts';
import { clothToy } from '../scripts/toys/cloth.ts';
import { doublePendulumToy } from '../scripts/toys/double-pendulum.ts';
import { gameOfLifeToy } from '../scripts/toys/game-of-life.ts';
import { tetrisSolverToy } from '../scripts/toys/tetris.ts';
import type { CanvasToy } from '../lib/types';

interface Props {
  toys?: CanvasToy[];
}

const toys: CanvasToy[] = Astro.props.toys ?? [boidsToy, clothToy, doublePendulumToy, gameOfLifeToy, tetrisSolverToy];

// For SSR, pick the first toy as default. The inline script handles
// randomisation / rotation on the client.
const defaultToy = toys[0];
---

<!-- The "Bored?" toggle button is rendered statically in Hero.astro's CTA row
     (id="canvas-toy-toggle"), like the other hero CTA buttons. It just triggers
     this panel. The inline script below finds it via getElementById. -->

<!-- Backdrop overlay — dims the left half, click to close -->
<div
  id="canvas-toy-backdrop"
  class="fixed top-0 left-0 bottom-0 z-40 pointer-events-none opacity-0 bg-black/30 transition-opacity duration-500"
  style="right: 50vw"
  aria-hidden="true"
></div>

<!-- Simulation panel — fixed overlay on right half -->
<div
  id="canvas-toy-panel"
  class="fixed top-0 right-0 h-full w-[50vw] z-50 translate-x-full bg-surface border-l border-border flex flex-col"
  aria-hidden="true"
>
  <!-- Header bar -->
  <div class="flex items-center gap-3 px-5 py-3 border-b border-border shrink-0">
    <span
      id="canvas-toy-header"
      class="text-[13px] text-ink-tertiary font-mono select-none flex-1 min-w-0"
    >
      {defaultToy.headerHtml}
    </span>
    <!-- Slot for toy-specific header controls (e.g. Game of Life pause toggle) -->
    <div id="canvas-toy-header-controls" class="flex items-center shrink-0"></div>
    <button
      id="canvas-toy-close"
      class="text-ink-tertiary hover:text-ink text-2xl leading-none p-1 cursor-pointer transition-colors bg-transparent border-0 shrink-0"
      aria-label="Close toy"
    >
      &times;
    </button>
  </div>

  <!-- Canvas fills remaining space -->
  <div id="canvas-toy-wrapper" class="flex-1 relative min-h-0">
    <canvas id="canvas-toy-canvas" class="absolute inset-0 w-full h-full"></canvas>
  </div>

  <!-- Footer bar -->
  <div class="px-5 py-3 border-t border-border shrink-0 relative z-10 bg-surface">
    <!-- Prev/next navigation row (hidden when only 1 toy) -->
    <div
      id="canvas-toy-nav"
      class="flex items-center justify-between mb-2 hidden"
    >
      <span class="text-[12px] text-ink-tertiary font-mono select-none">Try something else?</span>
      <div class="flex items-center gap-1">
        <button
          id="canvas-toy-nav-prev"
          class="inline-flex items-center justify-center w-7 h-7 rounded-[6px] text-ink-tertiary hover:text-accent hover:bg-accent-wash transition-colors cursor-pointer bg-transparent border-0"
          aria-label="Previous toy"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6" />
          </svg>
        </button>
        <span
          id="canvas-toy-nav-indicator"
          class="text-[12px] text-ink-tertiary font-mono select-none min-w-[28px] text-center"
        ></span>
        <button
          id="canvas-toy-nav-next"
          class="inline-flex items-center justify-center w-7 h-7 rounded-[6px] text-ink-tertiary hover:text-accent hover:bg-accent-wash transition-colors cursor-pointer bg-transparent border-0"
          aria-label="Next toy"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </button>
      </div>
    </div>
    <p
      id="canvas-toy-footer"
      class="text-[12px] text-ink-tertiary font-mono leading-relaxed select-none m-0"
    >
      {defaultToy.footerHtml}
    </p>
  </div>
</div>

<script>
  // Keep in sync with the frontmatter imports above when adding new toys.
  import { boidsToy } from '../scripts/toys/boids.ts';
  import { clothToy } from '../scripts/toys/cloth.ts';
  import { doublePendulumToy } from '../scripts/toys/double-pendulum.ts';
  import { gameOfLifeToy } from '../scripts/toys/game-of-life.ts';
  import { tetrisSolverToy } from '../scripts/toys/tetris.ts';
  import type { CanvasToy } from '../lib/types';

  /** All available toys (must match the frontmatter array above). */
  const TOYS: CanvasToy[] = [boidsToy, clothToy, doublePendulumToy, gameOfLifeToy, tetrisSolverToy];

  function initCanvasToy() {
    const toggleBtn = document.getElementById('canvas-toy-toggle');
    const panel = document.getElementById('canvas-toy-panel');
    const closeBtn = document.getElementById('canvas-toy-close');
    const backdrop = document.getElementById('canvas-toy-backdrop');
    const headerEl = document.getElementById('canvas-toy-header');
    const footerEl = document.getElementById('canvas-toy-footer');
    const controlsEl = document.getElementById('canvas-toy-header-controls');
    const navRow = document.getElementById('canvas-toy-nav');
    const navPrev = document.getElementById('canvas-toy-nav-prev');
    const navNext = document.getElementById('canvas-toy-nav-next');
    const navIndicator = document.getElementById('canvas-toy-nav-indicator');
    if (!toggleBtn || !panel || !closeBtn || !backdrop || !headerEl || !footerEl || !controlsEl) return;
    let isOpen = false;
    let simCleanup: (() => void) | null = null;
    let headerControlsCleanup: (() => void) | null = null;
    let lastToyId: string | null = null;
    let toyIndex = -1;

    /** Show/hide the prev/next nav row based on toy count. */
    function updateNavVisibility() {
      if (!navRow || !navIndicator) return;
      if (TOYS.length <= 1) {
        navRow.classList.add('hidden');
        return;
      }
      navRow.classList.remove('hidden');
      navIndicator.textContent = `${toyIndex + 1}/${TOYS.length}`;
    }

    /** Switch to the toy at the given index. Cleans up previous toy, starts new one. */
    function switchToToy(index: number) {
      if (!controlsEl || !headerEl || !footerEl) return;

      // Clean up previous simulation and header controls
      if (simCleanup) {
        simCleanup();
        simCleanup = null;
      }
      if (headerControlsCleanup) {
        headerControlsCleanup();
        headerControlsCleanup = null;
      }

      const toy = TOYS[index];
      toyIndex = index;
      lastToyId = toy.id;

      // Update header and footer
      headerEl.innerHTML = toy.headerHtml;
      footerEl.innerHTML = toy.footerHtml;

      // Render toy-specific header controls (e.g. Game of Life pause toggle)
      if (toy.renderHeaderControls) {
        const result = toy.renderHeaderControls(controlsEl);
        if (typeof result === 'function') {
          headerControlsCleanup = result;
        }
      }

      // Start the simulation
      const canvas = document.getElementById('canvas-toy-canvas') as HTMLCanvasElement | null;
      if (canvas) {
        try {
          simCleanup = toy.start(canvas);
        } catch (err) {
          console.error(`[CanvasToy] Failed to start "${toy.id}":`, err);
          simCleanup = null;
          // Show error in canvas area
          const ctx = canvas.getContext('2d');
          if (ctx) {
            ctx.fillStyle = 'var(--color-ink-tertiary)';
            ctx.font = '14px monospace';
            ctx.textAlign = 'center';
            ctx.fillText('This toy failed to start — try another.', canvas.width / 2, canvas.height / 2);
          }
        }
      }

      updateNavVisibility();
    }

    function open() {
      if (isOpen) return;
      isOpen = true;

      // Pick a random toy (avoid repeating if >1)
      let idx: number;
      if (TOYS.length <= 1) {
        idx = 0;
      } else {
        const candidates = TOYS.reduce<number[]>((acc, t, i) => {
          if (t.id !== lastToyId) acc.push(i);
          return acc;
        }, []);
        idx = candidates[Math.floor(Math.random() * candidates.length)];
      }

      panel!.style.translate = '0 0';
      panel!.setAttribute('aria-hidden', 'false');
      backdrop!.style.opacity = '1';
      backdrop!.style.pointerEvents = 'auto';
      backdrop!.setAttribute('aria-hidden', 'false');
      document.body.classList.add('canvas-toy-open');

      switchToToy(idx);
    }

    function close() {
      if (!isOpen) return;
      isOpen = false;
      panel!.style.translate = '';
      panel!.setAttribute('aria-hidden', 'true');
      backdrop!.style.opacity = '';
      backdrop!.style.pointerEvents = '';
      backdrop!.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('canvas-toy-open');

      // Stop simulation and header controls
      if (simCleanup) {
        simCleanup();
        simCleanup = null;
      }
      if (headerControlsCleanup) {
        headerControlsCleanup();
        headerControlsCleanup = null;
      }

      toyIndex = -1;
      updateNavVisibility();
    }

    toggleBtn.addEventListener('click', open);
    closeBtn.addEventListener('click', close);

    // Prev/next navigation
    navPrev?.addEventListener('click', () => {
      if (!isOpen || TOYS.length <= 1) return;
      const newIdx = (toyIndex - 1 + TOYS.length) % TOYS.length;
      switchToToy(newIdx);
    });

    navNext?.addEventListener('click', () => {
      if (!isOpen || TOYS.length <= 1) return;
      const newIdx = (toyIndex + 1) % TOYS.length;
      switchToToy(newIdx);
    });

    // Click outside the panel (on backdrop or content) closes it
    document.addEventListener('click', (e) => {
      if (isOpen && !panel.contains(e.target as Node) && e.target !== toggleBtn) {
        close();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) close();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCanvasToy);
  } else {
    initCanvasToy();
  }
</script>
