---
interface Props {
  label?: string;
  heading?: string;
  headingMb?: string;
  headingSize?: string;
}

const {
  label,
  heading,
  headingMb = 'mb-10',
  headingSize = 'text-[30px] md:text-[40px]',
} = Astro.props;
---

{
  (label || heading) && (
    <div class={headingMb}>
      {label && (
        <div class="flex items-center gap-4 mb-3">
          <p class="text-[13px] font-mono text-rust tracking-[0.18em] uppercase m-0 shrink-0">
            {label}
          </p>
          <span class="flex-1 h-px bg-border" aria-hidden="true" />
        </div>
      )}
      {heading && <h2 class={`font-display ${headingSize} font-bold text-ink m-0`}>{heading}</h2>}
    </div>
  )
}
