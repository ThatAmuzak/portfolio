---
interface Props {
  label?: string;
  headingMb?: string;
  headingSize?: string;
}

const {
  label,
  headingMb = 'mb-10',
  headingSize = 'text-[22px] md:text-[30px]',
} = Astro.props;

// Split "01 // About" into the number ("01") and the section name; the
// separator is rendered in light grey.
const match = label?.match(/^(\d+)\s*\/\/\s*(.*)$/);
const number = match?.[1] ?? '';
const name = match?.[2] ?? label ?? '';
---

{
  label && (
    <div class={headingMb}>
      <div class="flex items-center gap-4">
        <h2 class={`font-display ${headingSize} font-bold text-ink m-0`}>
          {number && <span class="text-rust">{number}</span>}
          <span class="text-ink-tertiary"> //</span>
          {name && ` ${name}`}
        </h2>
        <span class="flex-1 h-px bg-border" aria-hidden="true" />
      </div>
    </div>
  )
}
