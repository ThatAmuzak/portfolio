---
import { load, LORD_ICON_COLORS, liSrc } from '../lib/data';
import type { Education, Degree, DegreeHighlight } from '../lib/types';
import SectionHeader from './SectionHeader.astro';

const education = load<Education>('education.yaml');
const degrees: Degree[] = education.degrees || [];
---

<section id="education" class="py-24 md:py-32 px-6 bg-surface-sunken scroll-mt-16">
  <div class="max-w-[960px] mx-auto">
    <SectionHeader label={education.label} heading={education.heading} />

    {
      degrees.length > 0 && (
        <div>
          {degrees.map((deg: Degree) => (
            <div class="reveal py-7 border-b border-border first:pt-0 last:pb-0 last:border-0">
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-4">
                <div>
                  {deg.degree && (
                    <h3 class="font-display text-[21px] md:text-[23px] font-bold text-ink m-0">
                      {deg.degree}
                    </h3>
                  )}
                  {deg.institution && (
                    <p class="text-[16px] text-ink-secondary m-0 mt-1">
                      {deg.url ? (
                        <a
                          href={deg.url}
                          target="_blank"
                          rel="noopener"
                          class="text-ink-secondary hover:text-accent transition-colors duration-200 no-underline"
                        >
                          {deg.institution}
                        </a>
                      ) : (
                        deg.institution
                      )}
                    </p>
                  )}
                </div>
                <div class="sm:text-right shrink-0">
                  {deg.dateRange && (
                    <span class="text-[14px] text-ink-tertiary font-mono block">
                      {deg.dateRange}
                    </span>
                  )}
                  {deg.gpa && (
                    <span class="text-[13px] font-mono text-accent font-medium block mt-1">
                      {deg.gpa}
                    </span>
                  )}
                </div>
              </div>

              {deg.highlights && deg.highlights.length > 0 && (
                <div class="flex flex-wrap gap-2">
                  {deg.highlights.map((h: DegreeHighlight) => (
                    <div
                      class={`flex items-center gap-2 px-3 py-1.5 rounded-[6px] ${h.featured ? 'bg-rust-wash' : 'bg-surface-sunken'}`}
                    >
                      {h.icon && (
                        <lord-icon
                          src={liSrc(h.icon)}
                          trigger="morph"
                          colors={LORD_ICON_COLORS.default}
                          class="li-md"
                        />
                      )}
                      {h.text && (
                        <span class="text-[14px] text-ink-secondary font-medium">{h.text}</span>
                      )}
                    </div>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      )
    }
  </div>
</section>
