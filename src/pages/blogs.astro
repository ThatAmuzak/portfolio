---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const allPosts = await getCollection('blogs', ({ data }: CollectionEntry<'blogs'>) => !data.draft);
const posts = allPosts.sort(
  (a: CollectionEntry<'blogs'>, b: CollectionEntry<'blogs'>) =>
    b.data.date.getTime() - a.data.date.getTime(),
);

interface PostWithMeta {
  post: CollectionEntry<'blogs'>;
}
const postsWithMeta: PostWithMeta[] = posts.map((post: CollectionEntry<'blogs'>) => ({
  post,
}));

const title = 'Blogs — Rishav Banerjee';
const description = 'Articles on HCI, VR, robotics, and software development by Rishav Banerjee.';
---

<BaseLayout {title} {description}>
  <Navbar />

  <main id="main" class="pt-[64px]">
    <section class="py-24 md:py-32 px-6">
      <div class="max-w-[760px] mx-auto">
        <!-- Header -->
        <div class="mb-16">
          <div class="flex items-center gap-4 mb-3">
            <p class="text-[13px] font-mono text-rust tracking-[0.18em] uppercase m-0 shrink-0">
              // Articles
            </p>
            <span class="flex-1 h-px bg-border" aria-hidden="true"></span>
          </div>
          <h1
            class="font-display text-[30px] md:text-[40px] font-bold text-ink tracking-[-0.01em] leading-[1.15]"
          >
            Blogs
          </h1>
          <p class="mt-4 text-[17px] text-ink-secondary leading-[1.75] max-w-[600px]">
            Thoughts on HCI, VR, robotics, and software development.
          </p>
        </div>

        <!-- Post list -->
        {
          posts.length === 0 ? (
            <div class="text-center py-16">
              <div class="inline-block placard px-8 py-8 max-w-[420px]">
                <p class="text-[13px] font-mono text-rust tracking-[0.18em] uppercase m-0 mb-3">
                  Gallery being hung
                </p>
                <p class="text-[17px] text-ink-secondary m-0 leading-[1.7]">
                  No posts on this wall yet. The first exhibit goes up soon — check back.
                </p>
              </div>
            </div>
          ) : (
            <div class="space-y-8">
              {postsWithMeta.map((item) => (
                <article>
                  <a
                    href={`/blogs/${item.post.id}`}
                    class="block group p-6 -mx-6 hover:bg-surface-raised transition-colors duration-200 no-underline"
                  >
                    <div class="flex items-center gap-3 mb-2">
                      <time
                        datetime={item.post.data.date.toISOString().split('T')[0]}
                        class="text-[13px] font-mono text-ink-tertiary"
                      >
                        {item.post.data.date.toLocaleDateString('en-US', {
                          year: 'numeric',
                          month: 'long',
                          day: 'numeric',
                        })}
                      </time>
                      {item.post.data.tags && item.post.data.tags.length > 0 && (
                        <span class="flex items-center gap-1.5">
                          {item.post.data.tags.slice(0, 3).map((tag: string) => (
                            <span class="text-[12px] font-mono px-2 py-0.5 rounded-[2px] bg-surface-sunken text-ink-tertiary border border-border">
                              {tag}
                            </span>
                          ))}
                        </span>
                      )}
                    </div>
                    <h2 class="font-display text-[21px] md:text-[25px] font-bold text-ink group-hover:text-accent transition-colors duration-200 leading-[1.3]">
                      {item.post.data.title}
                    </h2>
                    {item.post.data.description && (
                      <p class="mt-2 text-[16px] text-ink-secondary leading-[1.65]">
                        {item.post.data.description}
                      </p>
                    )}
                    <span class="inline-flex items-center gap-1.5 mt-4 text-[14px] font-mono text-accent group-hover:text-accent-light transition-colors">
                      Read more
                      <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="group-hover:translate-x-0.5 transition-transform"
                      >
                        <line x1="5" y1="12" x2="19" y2="12" />
                        <polyline points="12 5 19 12 12 19" />
                      </svg>
                    </span>
                  </a>
                </article>
              ))}
            </div>
          )
        }
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
